<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <WebMinifierFolders>wwwroot/js</WebMinifierFolders>
        <WebMinifierCssEnabled>false</WebMinifierCssEnabled>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Seamlessly connects MAUI and Blazor, enabling smooth integration of native components into Blazor</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Maui.Blazor.Bridge</AssemblyName>
        <PackageId>Soenneker.Maui.Blazor.Bridge</PackageId>
        <PackageTags>maui blazor bridge callback js jsruntime interop razor mauiblazorbridge mauilibrary csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2025-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.maui.blazor.bridge</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.maui.blazor.bridge</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
        <PackageReference Include="Soenneker.Blazor.CallbackRegistry" Version="11.0.1216" />
        <PackageReference Include="Soenneker.Extensions.Double" Version="11.0.482" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Gen.Web.Minifier" Version="11.0.67" PrivateAssets="all" />
    </ItemGroup>
</Project>
